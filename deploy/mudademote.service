[Unit]
Description=MudaDemote 24/7 Headless Server & Pterodactyl Web Dashboard
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mudademote
ExecStart=/opt/mudademote/venv/bin/python mudae_server.py --host 0.0.0.0 --port 8080 --autostart
Restart=always
RestartSec=5s
KillMode=control-group

# EC2 Resource & Memory Guards
MemoryAccounting=true
MemoryHigh=650M
MemoryMax=850M
CPUAccounting=true
CPUWeight=100

# Security & Sandboxing
NoNewPrivileges=true
PrivateTmp=true

# Environment Variables
Environment=PYTHONUNBUFFERED=1
Environment=HOST=0.0.0.0
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
